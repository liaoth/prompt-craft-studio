# Application
NODE_ENV=development
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# PostgreSQL
DATABASE_URL=postgresql://promptforge:promptforge@localhost:5432/promptforge
# Docker 内部连接；用户名、密码和数据库名中的特殊字符必须 URL 编码。
DOCKER_DATABASE_URL=postgresql://promptforge:change-this-database-password@postgres:5432/promptforge
POSTGRES_DB=promptforge
POSTGRES_USER=promptforge
POSTGRES_PASSWORD=change-this-database-password

# SMTP（Docker Compose 默认使用 Mailpit；直接运行 npm run dev 时可改为 localhost）
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Prompt Craft <noreply@localhost>

# 生产环境允许用户配置的自定义 AI、翻译与 Midjourney HTTP 接口域名，逗号分隔。
# 官方预设供应商和 Discord Webhook 无需填写；例如：api.example.com,translate.example.com
CUSTOM_ENDPOINT_HOST_ALLOWLIST=

# Optional shared, free translation service
SHARED_LIBRETRANSLATE_URL=
SHARED_LIBRETRANSLATE_API_KEY=

# Public registration and network safety
ALLOW_SIGNUP=true
TRUST_PROXY=false
