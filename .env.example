# Prompt Craft Studio environment template
# 配置文档 / Configuration:
# docs/zh-CN/configuration.md | docs/en-US/configuration.md

# Application / 应用
NODE_ENV=development
APP_URL=http://localhost:3000
APP_PORT=3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
ALLOW_SIGNUP=true

# Generate BETTER_AUTH_SECRET and APP_ENCRYPTION_KEY separately:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Reverse proxy / 反向代理
# Only trust exact proxy IP/CIDR values after the origin is restricted to that proxy.
BETTER_AUTH_TRUSTED_PROXIES=
BETTER_AUTH_IP_HEADERS=x-forwarded-for

# PostgreSQL
POSTGRES_DB=promptforge
POSTGRES_USER=promptforge
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql://promptforge:promptforge@localhost:5432/promptforge
# Docker connection. URL-encode special characters in user/password/database names.
DOCKER_DATABASE_URL=postgresql://promptforge:change-this-database-password@postgres:5432/promptforge
DB_POOL_MAX=10

# SMTP
# Docker Compose uses Mailpit by default. For `npm run dev`, use localhost.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Prompt Craft <noreply@localhost>

# Optional site-wide AI. An active per-user configuration takes precedence.
# Providers: openai, anthropic, gemini, deepseek, qwen, doubao, zhipu, kimi,
# minimax, custom.
SITE_AI_PROVIDER=
SITE_AI_MODEL=
SITE_AI_API_KEY=
SITE_AI_ENDPOINT=
SITE_AI_TIMEOUT_MS=45000
# Docker Desktop + Ollama example:
# SITE_AI_PROVIDER=custom
# SITE_AI_MODEL=qwen2.5:3b
# SITE_AI_API_KEY=ollama
# SITE_AI_ENDPOINT=http://host.docker.internal:11434/v1/chat/completions

# Allow public custom AI, translation, or forwarding endpoint hosts.
# Comma-separated hostnames only; built-in providers and Discord need no entry.
CUSTOM_ENDPOINT_HOST_ALLOWLIST=

# Optional shared LibreTranslate
SHARED_LIBRETRANSLATE_URL=
SHARED_LIBRETRANSLATE_API_KEY=
# Use the exact language code supported by the instance: usually zh or zh-Hans.
SHARED_LIBRETRANSLATE_CHINESE_LANGUAGE_CODE=zh
